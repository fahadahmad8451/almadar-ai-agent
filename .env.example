# Al Madar Holding — Enterprise AI Agent (.env.example)
# Copy to .env and fill in real values. Never commit a real .env.
# The JWT secret below is a placeholder — production refuses to start
# with a placeholder or short secret (same rule as Project 1 v0.10).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/almadar_agent
JWT_SECRET=CHANGE-ME-USE-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS

OLLAMA_HOST=http://127.0.0.1:11434
SUPERVISOR_MODEL=llama3.1:8b
SUBAGENT_MODEL=qwen2.5:7b

API_PORT=8100
WEB_PORT=3100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# n8n webhook trigger (Sprint 3). Leave empty to disable the webhook
# (it returns 503). Set a long random secret to enable it; n8n must
# send the same value in the X-Webhook-Secret header.
AMH_N8N_WEBHOOK_SECRET=

# Invoice PDF upload (Sprint 3)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Agent safety limits (Design section 9)
CONFIDENCE_THRESHOLD=0.70
MAX_STEPS_PER_RUN=15
MAX_TOOL_RETRIES=3
MAX_RUN_SECONDS=300
