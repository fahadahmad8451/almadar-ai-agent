# Production environment — Al Madar Holding AI Agent v0.8.0
# Copy to .env.production and fill in the secret. NEVER commit the
# real file (.gitignore excludes .env.production).
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Loaded with AMH_ENV_FILE=.env.production (see backend/app/core/config.py).

ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/almadar_agent_prod
JWT_SECRET=CHANGE-ME-SET-A-STRONG-SECRET-IN-.env.production

OLLAMA_HOST=http://127.0.0.1:11434
SUPERVISOR_MODEL=llama3.1:8b
SUBAGENT_MODEL=qwen2.5:7b

API_PORT=8100
WEB_PORT=3100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
DEBUG=false

# Scheduler ON in production — the three locked jobs fire on their
# schedule (daily 08:00, weekly Mon 09:00, month-end 1st 09:00,
# Asia/Riyadh), running as the Admin created by create_admin.py.
SCHEDULER_ENABLED=true

# n8n webhook stays disabled unless a real secret is set
# (empty secret -> 503).
AMH_N8N_WEBHOOK_SECRET=

# Production data dirs (separate from dev's data/ and staging's
# data-staging/). Backed up by scripts/backup.py.
EXPORT_DIR=./data-prod/exports
UPLOAD_DIR=./data-prod/uploads
MAX_UPLOAD_MB=10

# Agent safety limits (Design section 9)
CONFIDENCE_THRESHOLD=0.70
MAX_STEPS_PER_RUN=15
MAX_TOOL_RETRIES=3
MAX_RUN_SECONDS=300

# Monitoring alert checks (v0.9.0) — OFF in staging by default.
MONITORING_ALERTS_ENABLED=false
